# Local Python runs use this SQLite URL. Compose builds a PostgreSQL URL safely from DB_* values.
DATABASE_URL=sqlite:///./member_6_backend/data/backend.db
STORAGE_DIR=./member_6_backend/data/evidence
# Compose interpolation inputs. Set a private local value before starting the stack.
POSTGRES_DB=reality_reconstructor
POSTGRES_USER=reality_app
POSTGRES_PASSWORD=
MAX_UPLOAD_BYTES=26214400
ALLOWED_EXTENSIONS=pdf,txt,csv,json,png,jpg,jpeg,webp,mp4,mov,wav,mp3,docx
ADAPTER_MODE=mock
# Set only when ADAPTER_MODE=real. Format: importable.module:factory_function
REAL_ADAPTER_FACTORY=
PROCESSING_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
